---
interface Props { title: string; text?: string; href: string; label: string; href2?: string; label2?: string }
const { title, text, href, label, href2, label2 } = Astro.props;
---
<section class="band">
  <img class="band__mark" src="/images/sign-gold.svg" alt="" aria-hidden="true" loading="lazy" />
  <div class="wrap band__in reveal">
    <h2>{title}</h2>
    {text && <p class="lead">{text}</p>}
    <div class="band__actions">
      <a class="btn" href={href}>{label} <span class="arrow">→</span></a>
      {href2 && <a class="btn btn--ghost" href={href2}>{label2}</a>}
    </div>
  </div>
</section>
<style>
  .band { position: relative; overflow: hidden; color: var(--cream); background: linear-gradient(118deg, transparent 20%, rgba(255,255,255,.07) 38%, transparent 56%), var(--navy) url('/images/texture-navy.jpg') center / cover; background-blend-mode: screen, normal; text-align: center; }
  .band__mark { position: absolute; left: 50%; top: 50%; width: min(70vw, 760px); transform: translate(-50%, -50%); opacity: 0.05; pointer-events: none; }
  .band::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 22, 56, 0.55), rgba(17, 33, 80, 0.25) 50%, rgba(11, 22, 56, 0.6)); }
  .band__in { position: relative; padding-top: clamp(96px, 12vw, 160px); padding-bottom: clamp(96px, 12vw, 160px); }
  .band h2 { font-weight: 400; max-width: 760px; margin: 0 auto 20px; }
  .band .lead { color: var(--muted-light); margin: 0 auto; }
  .band__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
</style>
