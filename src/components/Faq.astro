---
/** Questions fréquentes (accordéon). Les données structurées FAQPage sont ajoutées par la page. */
interface Props { eyebrow: string; title: string; items: { q: string; a: string }[]; sand?: boolean }
const { eyebrow, title, items, sand = false } = Astro.props;
---
<section class:list={['section', { 'section--sand': sand }]} id="faq">
  <div class="wrap faq">
    <div class="reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="faq__list">
      {items.map((it, i) => (
        <details class="reveal" open={i === 0}>
          <summary><h3>{it.q}</h3><span aria-hidden="true">+</span></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .faq__list details { border-top: 1px solid var(--line); }
  .faq__list details:last-child { border-bottom: 1px solid var(--line); }
  .faq__list summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; cursor: pointer; list-style: none; }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list h3 { font-size: 1.08rem; margin: 0; }
  .faq__list summary span { flex: none; font-size: 1.5rem; color: var(--gold); transition: transform 0.3s var(--ease); }
  .faq__list details[open] summary span { transform: rotate(45deg); }
  .faq__list p { color: var(--muted); margin: 0 0 24px; max-width: 680px; }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } }
</style>
