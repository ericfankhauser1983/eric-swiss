---
/**
 * Fond animé des hauts de page : vidéo (si fournie dans HERO_VIDEOS) ou faisceaux lumineux animés.
 */
interface Props { video?: string; poster?: string }
const { video, poster } = Astro.props;
---
<div class="hbg" aria-hidden="true">
  {video ? (
    <video class="hbg__video" src={video} poster={poster} autoplay muted loop playsinline preload="metadata"></video>
  ) : (
    <>
      <div class="hbg__tex"></div>
      <div class="hbg__beam hbg__beam--1"></div>
      <div class="hbg__beam hbg__beam--2"></div>
      <div class="hbg__beam hbg__beam--3"></div>
    </>
  )}
  <div class="hbg__shade" class:list={{ 'hbg__shade--video': !!video }}></div>
</div>
<style>
  .hbg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hbg__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hbg__tex { position: absolute; inset: -6%; background: url('/images/texture-navy.jpg') center / cover; animation: drift 38s ease-in-out infinite alternate; opacity: 0.95; }
  .hbg__beam { position: absolute; top: -40%; height: 180%; width: 22%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent); transform: rotate(28deg); filter: blur(6px); animation: sweep 16s ease-in-out infinite; }
  .hbg__beam--1 { left: -30%; }
  .hbg__beam--2 { left: -30%; width: 12%; animation-delay: -5s; animation-duration: 21s; background: linear-gradient(90deg, transparent, rgba(203, 178, 145, 0.09), transparent); }
  .hbg__beam--3 { left: -30%; width: 34%; animation-delay: -11s; animation-duration: 27s; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.045), transparent); }
  .hbg__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(17, 33, 80, 0.15), rgba(11, 22, 56, 0.55)); }
  .hbg__shade--video { background: linear-gradient(90deg, rgba(11, 22, 56, 0.9) 0%, rgba(11, 22, 56, 0.6) 55%, rgba(11, 22, 56, 0.35) 100%); }
  @keyframes sweep { 0% { transform: translateX(0) rotate(28deg); } 100% { transform: translateX(620%) rotate(28deg); } }
  @keyframes drift { 0% { transform: scale(1) translate(0, 0); } 100% { transform: scale(1.08) translate(-2%, 1.5%); } }
  @media (prefers-reduced-motion: reduce) { .hbg__beam, .hbg__tex { animation: none; } .hbg__video { display: none; } }
</style>
