---
import Photo from './Photo.astro';
import HeroBg from './HeroBg.astro';
interface Props { eyebrow?: string; title: string; lead?: string; size?: 'xl' | 'md'; photo?: string; video?: string }
const { eyebrow, title, lead, size = 'md', photo, video } = Astro.props;
const withPhoto = photo !== undefined;
---
<section class:list={['hero', `hero--${size}`, { 'hero--photo': withPhoto }]}>
  <HeroBg video={video} />
  {!withPhoto && <img class="hero__mark" src="/images/sign-gold.svg" alt="" aria-hidden="true" width="540" height="340" />}
  <div class="wrap hero__in">
   <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <div class="hero__actions"><slot /></div>
   </div>
   {withPhoto && <div class="hero__photo"><Photo src={photo} alt="" ratio="4 / 5" eager /></div>}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--navy); color: var(--cream); }
  .hero__mark { position: absolute; right: -4%; bottom: -14%; width: min(46vw, 620px); height: auto; opacity: 0.08; pointer-events: none; }
  .hero__in { position: relative; padding-top: clamp(80px, 11vw, 150px); padding-bottom: clamp(80px, 10vw, 136px); }
  .hero--xl .hero__in { padding-top: clamp(96px, 14vw, 190px); padding-bottom: clamp(96px, 13vw, 170px); }
  .hero h1 { max-width: 900px; margin-bottom: 28px; font-weight: 400; }
  .hero--md h1 { font-size: clamp(2.1rem, 4.4vw, 3.6rem); max-width: 820px; }
  .hero .lead { color: var(--muted-light); max-width: 640px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
  .hero__actions:empty { display: none; }
  .hero--photo .hero__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(32px, 6vw, 88px); align-items: center; padding-top: clamp(56px, 8vw, 104px); padding-bottom: clamp(56px, 8vw, 104px); }
  .hero__photo { max-width: 400px; width: 100%; justify-self: end; }
  @media (max-width: 860px) { .hero--photo .hero__in { grid-template-columns: 1fr; } .hero__photo { display: none; } }
  .hero :global(em) { font-style: normal; color: var(--gold-light); }
</style>
