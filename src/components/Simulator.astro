---
/**
 * Simulateur d'investissement.
 * Étape 1 : mode de financement — Étape 2 : finition + stratégie — Étape 3 : le bien (curseurs).
 * À la première simulation, le visiteur renseigne prénom, nom, e-mail et WhatsApp ;
 * la simulation complète est alors envoyée par e-mail (voir FORM dans src/config/site.ts).
 * Le taux du crédit (7,5 %) se règle dans src/scripts/sim-core.ts (CREDIT_RATE).
 */
import { FORM, path, type Lang } from '../config/site';
import { t } from '../i18n/ui';
interface Props { lang: Lang; bookHref: string; source?: string; /** message affiché sous le résultat (ex. landing calculateur) */ note?: string; /** masque le bouton de rendez-vous du résultat */ noBook?: boolean }
const { lang, bookHref, source = '', note = '', noBook = false } = Astro.props;
const ui = t(lang).sim;

/** Valeurs par défaut et bornes des curseurs */
const D = {
  currency: 'USD',
  price: 120000,
  budget: 100000,
  /** Frais de notaire et d'enregistrement (fixes, non modifiables par le visiteur, inclus dans les calculs et dans l'e-mail) */
  notary: { USD: 5750, EUR: 5000, CHF: 4700 } as Record<string, number>,
  delivery: { min: 0, max: 48, step: 1, value: 12 },
  holding: { min: 6, max: 240, step: 6, value: 60 },
  yieldPct: { min: 4, max: 18, step: 0.5, value: 10 },
  apprPct: { min: 0, max: 15, step: 0.5, value: 9 },
  planDown: { min: 10, max: 70, step: 5, value: 30 },
  planMonths: { min: 6, max: 60, step: 6, value: 36 },
  creditDown: { min: 20, max: 90, step: 5, value: 30 },
  creditYears: { min: 1, max: 20, step: 1, value: 10 },
};
const R = D.yieldPct.max - D.yieldPct.min;
const zone = (a: number, b: number) => `left:calc(12px + (100% - 24px) * ${(a - D.yieldPct.min) / R});width:calc((100% - 24px) * ${(b - a) / R})`;

const cfg = JSON.stringify({ lang, source, ui, notary: D.notary, form: { provider: FORM.provider, key: FORM.web3formsKey } });
const fin = [
  { v: 'cash', t: ui.cash, d: ui.cashDesc },
  { v: 'plan', t: ui.plan, d: ui.planDesc },
  { v: 'credit', t: ui.credit, d: ui.creditDesc },
];
const slider = (name: keyof typeof D, label: string, fmt: string) => ({ name, label, fmt, ...(D[name] as any) });
---
<div class="sim" data-sim data-cfg={cfg}>
  <form class="sim__form" data-params novalidate>
    <div class="mode" role="radiogroup">
      <label class="mode__c"><input type="radio" name="mode" value="budget" checked /><span><strong>{ui.modeBudget}</strong><em>{ui.modeBudgetDesc}</em></span></label>
      <label class="mode__c"><input type="radio" name="mode" value="price" /><span><strong>{ui.modePrice}</strong><em>{ui.modePriceDesc}</em></span></label>
    </div>

    <fieldset class="st" data-mode="budget">
      <legend class="st__h"><span>1</span>{ui.stepBudget}</legend>
      <div class="grid3">
        <div class="opt">
          <span class="opt__l">{ui.currency}</span>
          <div class="seg">
            {['USD', 'EUR', 'CHF'].map((c) => <label><input type="radio" name="currencyB" value={c} checked={c === D.currency} /><span>{c}</span></label>)}
          </div>
        </div>
        <label class="fld"><span class="opt__l">{ui.budget}</span><span class="fld__in fld__in--big"><input type="number" name="budget" min="10000" step="5000" value={D.budget} inputmode="numeric" /><em data-cur>{D.currency}</em></span></label>
      </div>
      <div class="chips" aria-hidden="true">
        {[50000, 100000, 250000, 500000].map((v) => <button type="button" class="chip" data-budget={v}>{new Intl.NumberFormat('fr-CH').format(v)}</button>)}
      </div>
    </fieldset>

    <fieldset class="st" data-mode="price">
      <legend class="st__h"><span>1</span>{ui.step1}</legend>
      <div class="fin">
        {fin.map((f, i) => (
          <label class="fin__c">
            <input type="radio" name="financing" value={f.v} checked={i === 0} />
            <span class="fin__b"><strong>{f.t}</strong><em>{f.d}</em></span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="st">
      <legend class="st__h"><span>2</span>{ui.step2}</legend>
      <div class="opts">
        <div class="opt">
          <span class="opt__l">{ui.finish}</span>
          <div class="seg">
            {[['brut', ui.finishBrut], ['turnkey', ui.finishTurnkey]].map(([v, l], i) => (
              <label><input type="radio" name="finish" value={v} checked={i === 1} /><span>{l}</span></label>
            ))}
          </div>
        </div>
        <div class="opt">
          <span class="opt__l">{ui.strategy}</span>
          <div class="seg">
            {[['rent', ui.strategyRent], ['resale', ui.strategyResale]].map(([v, l], i) => (
              <label><input type="radio" name="strategy" value={v} checked={i === 0} /><span>{l}</span></label>
            ))}
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="st">
      <legend class="st__h"><span>3</span><b data-mode="price">{ui.step3}</b><b data-mode="budget">{ui.stepHyp}</b></legend>
      <div class="grid3" data-mode="price">
        <div class="opt">
          <span class="opt__l">{ui.currency}</span>
          <div class="seg">
            {['USD', 'EUR', 'CHF'].map((c) => <label><input type="radio" name="currency" value={c} checked={c === D.currency} /><span>{c}</span></label>)}
          </div>
        </div>
        <label class="fld"><span class="opt__l">{ui.price}</span><span class="fld__in"><input type="number" name="price" min="10000" step="1000" value={D.price} inputmode="numeric" /><em data-cur>{D.currency}</em></span></label>
      </div>

      <div class="sliders">
        <div class="rg" data-only="rent">
          <div class="rg__top"><span class="opt__l">{ui.yield}</span><output data-out="yieldPct"></output></div>
          <input type="range" name="yieldPct" min={D.yieldPct.min} max={D.yieldPct.max} step={D.yieldPct.step} value={D.yieldPct.value} data-fmt="pct" />
          <div class="zones" aria-hidden="true">
            <span class="zone zone--long" style={zone(6, 10)} data-zone="long"><b>6–10 %</b>{ui.zoneLong}</span>
            <span class="zone zone--short" style={zone(10, 15)} data-zone="short"><b>10–15 %</b>{ui.zoneShort}</span>
          </div>
          <p class="rg__badge" data-badge></p>
        </div>
        <div class="rg">
          <div class="rg__top"><span class="opt__l">{ui.appreciation}</span><output data-out="apprPct"></output></div>
          <input type="range" name="apprPct" min={D.apprPct.min} max={D.apprPct.max} step={D.apprPct.step} value={D.apprPct.value} data-fmt="pct" />
          <div class="mark" style={`left:calc(12px + (100% - 24px) * ${(9 - D.apprPct.min) / (D.apprPct.max - D.apprPct.min)})`} aria-hidden="true"><span></span><em>9 % · {ui.marketAvg}</em></div>
        </div>
        {[slider('delivery', ui.delivery, 'delivery'), slider('holding', ui.holding, 'months')].map((s) => (
          <div class="rg">
            <div class="rg__top"><span class="opt__l">{s.label}</span><output data-out={s.name}></output></div>
            <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} value={s.value} data-fmt={s.fmt} />
          </div>
        ))}
        <p class="terms" data-mode="budget">{ui.financingTerms}</p>
        {[slider('planDown', ui.planDown, 'pct'), slider('planMonths', ui.planMonths, 'count')].map((s) => (
          <div class="rg" data-fin="plan">
            <div class="rg__top"><span class="opt__l"><em class="rg__fin" data-mode="budget">{ui.plan} · </em>{s.label}</span><output data-out={s.name}></output></div>
            <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} value={s.value} data-fmt={s.fmt} />
          </div>
        ))}
        {[slider('creditDown', ui.creditDown, 'pct'), slider('creditYears', ui.creditYears, 'years')].map((s) => (
          <div class="rg" data-fin="credit">
            <div class="rg__top"><span class="opt__l"><em class="rg__fin" data-mode="budget">{ui.credit} · </em>{s.label}</span><output data-out={s.name}></output></div>
            <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} value={s.value} data-fmt={s.fmt} />
          </div>
        ))}
      </div>
    </fieldset>

    <button class="btn sim__go" type="submit"><b data-mode="budget">{ui.computeBudget}</b><b data-mode="price">{ui.compute}</b> <span class="arrow">→</span></button>
  </form>

  <!-- Formulaire de contact : Netlify Forms détecte ce formulaire au déploiement -->
  <div class="sim__lead" data-lead hidden>
    <p class="teaser" data-teaser></p>
    <h3>{ui.formTitle}</h3>
    <p>{ui.formLead}</p>
    <form name="simulation" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-leadform novalidate>
      <input type="hidden" name="form-name" value="simulation" />
      <input type="hidden" name="langue" value={lang} />
      <input type="hidden" name="resume" value="" />
      <p class="visually-hidden"><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="lead2">
        <label class="fld"><span class="opt__l">{ui.firstName}</span><span class="fld__in"><input name="prenom" required autocomplete="given-name" /></span></label>
        <label class="fld"><span class="opt__l">{ui.lastName}</span><span class="fld__in"><input name="nom" required autocomplete="family-name" /></span></label>
        <label class="fld"><span class="opt__l">{ui.email}</span><span class="fld__in"><input name="email" type="email" required autocomplete="email" /></span></label>
        <label class="fld"><span class="opt__l">{ui.whatsapp} <small class="fld__hint">· {ui.phoneHint}</small></span><span class="fld__in"><input name="whatsapp" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+41 79 000 00 00" pattern="\s*(\+|00)\s*[1-9][\d\s().\-]{6,}" title={ui.phoneIntl} /></span></label>
      </div>
      <label class="chk"><input type="checkbox" name="consentement" value="oui" required /> <span>{ui.consent} <a href={path('privacy', lang)} target="_blank">{ui.privacyLink}</a></span></label>
      <label class="chk chk--nl"><input type="checkbox" name="newsletter" value="oui" /> <span>{ui.newsletter}</span></label>
      <p class="sim__err" data-err hidden>{ui.required}</p>
      <button class="btn" type="submit" data-submit>{ui.submit} <span class="arrow">→</span></button>
    </form>
  </div>

  <div class="sim__res" data-res hidden>
    <div class="sim__res-head">
      <div><p class="eyebrow" data-res-tag></p><h3 data-res-title>{ui.results}</h3></div>
      <button type="button" class="link" data-edit>{ui.edit} ↑</button>
    </div>
    <p class="sim__status" data-status hidden></p>
    <div class="mx" data-mx>
      <p class="mx__l" data-mx-label></p>
      <p class="mx__v"><span class="mx__x">×</span><span data-mx-val></span></p>
      <p class="mx__line" data-mx-line></p>
    </div>
    {note && <p class="sim__note"><span aria-hidden="true">✓</span>{note}</p>}
    <div class="kpis" data-kpis></div>
    <div class="sim__table" data-table></div>
    <div class="cmp" data-cmp hidden></div>
    <div class="sim__foot">
      <div>
        <p class="sim__hyp-t">{ui.hypotheses}</p>
        <ul class="sim__hyp" data-hyp></ul>
        <p class="sim__disc">{ui.disclaimer}</p>
      </div>
      {!noBook && <a class="btn btn--navy" href={bookHref}>{ui.book} <span class="arrow">→</span></a>}
    </div>
  </div>
</div>

<style>
  .mode { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-bottom: clamp(32px, 4vw, 48px); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #fff; }
  .mode__c { cursor: pointer; }
  .mode__c input { position: absolute; opacity: 0; pointer-events: none; }
  .mode__c span { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 20px 24px; transition: all 0.3s var(--ease); }
  .mode__c + .mode__c span { border-left: 1px solid var(--line); }
  .mode__c strong { font-family: var(--f-title); font-weight: 500; font-size: 1.12rem; color: var(--navy); }
  .mode__c em { font-style: normal; font-size: 0.86rem; color: var(--muted); }
  .mode__c input:checked + span { background: var(--gold); }
  .mode__c input:checked + span strong { color: var(--cream); }
  .mode__c input:checked + span em { color: rgba(255, 254, 251, 0.85); }
  .mode__c input:focus-visible + span { outline: 2px solid var(--navy); outline-offset: -2px; }
  @media (max-width: 560px) { .mode { grid-template-columns: 1fr; } .mode__c + .mode__c span { border-left: 0; border-top: 1px solid var(--line); } }
  [data-mode][hidden] { display: none !important; }
  .st__h b { font-weight: inherit; }
  .fld__in--big input { height: 56px; font-size: 1.35rem; font-family: var(--f-title); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -18px; }
  .chip { font: 500 0.82rem var(--f-title); padding: 8px 14px; border: 1px solid var(--line); background: #fff; color: var(--navy); border-radius: 999px; cursor: pointer; transition: all 0.2s; }
  .chip:hover, .chip.is-on { border-color: var(--gold); background: rgba(173, 142, 104, 0.12); }
  .terms { grid-column: 1 / -1; margin: 6px 0 -14px; font-family: var(--f-title); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-deep); }
  .teaser { font-family: var(--f-title); font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.4; color: var(--navy); background: #fff; border-left: 3px solid var(--gold); padding: 18px 22px; margin: 0 0 28px; max-width: 760px; }
  .rg__fin { font-style: normal; color: var(--gold-deep); }
  .rg__fin[hidden] { display: none; }
  .teaser:empty { display: none; }
  .teaser :global(strong) { color: var(--gold-deep); font-weight: 500; }
  .cmp :global(.cmp__lead) { color: var(--muted); margin: -8px 0 24px; max-width: 720px; }
  .cmp :global(.cmp__grid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .cmp :global(.cmp__card) { position: relative; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 22px 20px; background: #fff; display: flex; flex-direction: column; }
  .cmp :global(.cmp__card.is-best) { border-color: var(--navy); box-shadow: inset 0 -3px 0 var(--gold), 0 20px 50px -30px rgba(17, 33, 80, 0.5); }
  .cmp :global(.cmp__badge) { position: absolute; top: -12px; left: 18px; background: var(--gold); color: var(--cream); font: 600 0.68rem var(--f-title); letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 10px; border-radius: 2px; white-space: nowrap; }
  .cmp :global(.cmp__card h4) { font-size: 1.12rem; margin: 0 0 18px; }
  .cmp :global(.cmp__big span) { display: block; font-size: 0.76rem; color: var(--muted); margin-bottom: 4px; }
  .cmp :global(.cmp__big strong) { display: block; font-family: var(--f-title); font-weight: 400; font-size: clamp(1.5rem, 2.4vw, 1.9rem); color: var(--navy); letter-spacing: -0.02em; margin-bottom: 16px; }
  .cmp :global(.cmp__card.is-best .cmp__big strong) { color: var(--gold-deep); }
  .cmp :global(.cmp__rows) { list-style: none; padding: 0; margin: auto 0 0; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .cmp :global(.cmp__rows li) { display: flex; justify-content: space-between; gap: 10px; padding: 9px 0; border-top: 1px solid var(--line); }
  .cmp :global(.cmp__rows li span) { color: var(--muted); }
  .cmp :global(.cmp__rows li b) { font-weight: 500; color: var(--navy); text-align: right; }
  .cmp :global(.cmp__rows .neg) { color: #a3442c; }
  @media (max-width: 860px) { .cmp :global(.cmp__grid) { grid-template-columns: 1fr; } .cmp :global(.cmp__card + .cmp__card) { margin-top: 8px; } .cmp :global(.cmp__card.is-best) { order: -1; margin: 6px 0 14px; } }
  .sim { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 30px 80px -40px rgba(17, 33, 80, 0.35); }
  .sim__form { padding: clamp(24px, 4vw, 52px); }
  .st { border: 0; padding: 0; margin: 0 0 clamp(32px, 4vw, 48px); min-width: 0; }
  .st__h { display: flex; align-items: center; gap: 14px; font-family: var(--f-title); font-size: clamp(1.1rem, 1.6vw, 1.3rem); font-weight: 500; margin-bottom: 20px; padding: 0; }
  .st__h span { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--navy); color: var(--gold-light); font-size: 0.85rem; font-weight: 600; flex: none; }

  .fin { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .fin__c { cursor: pointer; }
  .fin__c input { position: absolute; opacity: 0; pointer-events: none; }
  .fin__b { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 22px 22px 20px; border: 1px solid var(--line); border-radius: var(--radius); transition: all 0.3s var(--ease); background: #fff; }
  .fin__b strong { font-family: var(--f-title); font-weight: 500; font-size: 1.1rem; }
  .fin__b em { font-style: normal; font-size: 0.86rem; color: var(--muted); line-height: 1.5; }
  .fin__c input:checked + .fin__b { background: var(--navy); border-color: var(--navy); color: var(--cream); box-shadow: inset 0 -3px 0 var(--gold); }
  .fin__c input:checked + .fin__b em { color: var(--muted-light); }
  .fin__c input:focus-visible + .fin__b { outline: 2px solid var(--gold); outline-offset: 2px; }
  @media (max-width: 760px) { .fin { grid-template-columns: 1fr; } }

  .opts { display: flex; flex-wrap: wrap; gap: 24px 48px; }
  .opt__l { display: block; font-size: 0.82rem; color: var(--muted); margin-bottom: 9px; line-height: 1.35; }
  .seg { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: 11px 18px; font-family: var(--f-title); font-size: 0.86rem; font-weight: 500; color: var(--muted); transition: all 0.25s; }
  .seg input:checked + span { background: var(--gold); color: var(--cream); }
  .seg input:focus-visible + span { outline: 2px solid var(--navy); }

  .grid3 { display: grid; grid-template-columns: auto minmax(0, 420px); gap: 20px 24px; align-items: end; margin-bottom: 36px; }
  @media (max-width: 760px) { .grid3 { grid-template-columns: minmax(0, 1fr); } }
  .grid3 > * { min-width: 0; }
  .fld { display: block; }
  .fld__in { display: flex; align-items: center; border: 1px solid var(--line); background: #fff; border-radius: var(--radius); }
  .fld__in:focus-within { border-color: var(--gold); }
  .fld__in input { flex: 1; min-width: 0; height: 46px; padding: 0 14px; border: 0; background: transparent; font: 400 1rem var(--f-text); color: inherit; outline: none; -moz-appearance: textfield; }
  .fld__in input::-webkit-outer-spin-button, .fld__in input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .fld__in em { font-style: normal; font-size: 0.78rem; padding-right: 14px; color: var(--gold-deep); }

  .sliders { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 56px; }
  .sliders [data-only='rent'] { grid-column: 1 / -1; }
  @media (max-width: 760px) { .sliders { grid-template-columns: 1fr; } }
  .rg[hidden] { display: none; }
  .rg__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .rg__top output { font-family: var(--f-title); font-size: 1.35rem; color: var(--navy); white-space: nowrap; }
  .rg input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 28px; background: transparent; margin: 4px 0 0; cursor: pointer; --p: 50%; }
  .rg input[type='range']::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--gold) var(--p), rgba(17, 33, 80, 0.14) var(--p)); }
  .rg input[type='range']::-moz-range-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--gold) var(--p), rgba(17, 33, 80, 0.14) var(--p)); }
  .rg input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -10px; border-radius: 50%; background: var(--navy); border: 3px solid var(--gold); box-shadow: 0 4px 12px rgba(17, 33, 80, 0.3); transition: transform 0.2s; }
  .rg input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--navy); border: 3px solid var(--gold); }
  .rg input[type='range']:active::-webkit-slider-thumb { transform: scale(1.15); }

  .zones { position: relative; height: 54px; margin-top: 8px; }
  .zone { position: absolute; top: 0; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 0 12px; font-size: 0.74rem; line-height: 1.3; color: var(--muted); border-top: 3px solid; transition: all 0.35s var(--ease); overflow: hidden; white-space: nowrap; }
  .zone b { font-family: var(--f-title); font-weight: 600; font-size: 0.82rem; color: var(--navy); }
  .zone--long { border-color: #8fa0c9; background: rgba(143, 160, 201, 0.12); }
  .zone--short { border-color: var(--gold); background: rgba(173, 142, 104, 0.12); }
  .zone.is-on { color: var(--navy); }
  .zone--long.is-on { background: rgba(143, 160, 201, 0.32); }
  .zone--short.is-on { background: rgba(173, 142, 104, 0.32); }
  .rg__badge { margin: 12px 0 0; font-family: var(--f-title); font-size: 0.86rem; color: var(--gold-deep); min-height: 1.4em; }
  @media (max-width: 560px) { .zone { font-size: 0.66rem; padding: 0 6px; } .zone b { font-size: 0.74rem; } }

  .rg { position: relative; }
  .mark { position: relative; height: 40px; margin-top: 2px; transform: translateX(-50%); width: max-content; display: flex; flex-direction: column; align-items: center; pointer-events: none; }
  .mark span { width: 2px; height: 12px; background: var(--gold-deep); }
  .mark em { font-style: normal; font-family: var(--f-title); font-size: 0.74rem; font-weight: 500; color: var(--gold-deep); background: rgba(173, 142, 104, 0.14); padding: 3px 9px; border-radius: 20px; margin-top: 4px; white-space: nowrap; }
  .sim__go { margin-top: 8px; }

  .sim__lead { border-top: 1px solid var(--line); background: var(--sand); padding: clamp(28px, 4vw, 52px); }
  .sim__lead h3 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .sim__lead > p { color: var(--muted); max-width: 720px; }
  .lead2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; max-width: 760px; margin: 24px 0 8px; }
  @media (max-width: 560px) { .lead2 { grid-template-columns: 1fr; } }
  .chk { display: flex; gap: 12px; align-items: flex-start; font-size: 0.85rem; color: var(--muted); margin: 16px 0 22px; cursor: pointer; max-width: 760px; }
  .chk input { margin-top: 4px; accent-color: var(--gold); width: 16px; height: 16px; flex: none; }
  .chk a { color: var(--gold-deep); }
  .chk--nl { margin-top: -10px; }
  .fld__hint { font-size: 0.72rem; color: var(--muted); font-weight: 400; }
  .sim__err { color: #a3442c; font-size: 0.88rem; }

  .sim__res { border-top: 1px solid var(--line); padding: clamp(24px, 4vw, 52px); }
  .sim__res-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .sim__res-head .eyebrow { margin-bottom: 8px; }
  .sim__res-head h3 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0; }
  .sim__res-head .link { background: none; border-top: 0; border-left: 0; border-right: 0; cursor: pointer; }
  .sim__status { padding: 14px 18px; background: var(--sand); border-left: 2px solid var(--gold); font-size: 0.92rem; }
  .sim__status.is-err { border-left-color: #a3442c; }
  .mx { position: relative; overflow: hidden; text-align: center; background: var(--navy) url('/images/texture-navy.jpg') center / cover; color: var(--cream); border-radius: var(--radius); padding: clamp(28px, 4vw, 48px) 20px clamp(26px, 3.5vw, 40px); margin-bottom: 20px; box-shadow: inset 0 -4px 0 var(--gold); }
  .mx::before { content: ''; position: absolute; inset: 12px; border: 1px solid rgba(173, 142, 104, 0.35); pointer-events: none; }
  .mx__l { position: relative; margin: 0 0 6px; font-family: var(--f-title); font-size: clamp(0.78rem, 1.3vw, 0.9rem); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-light); }
  .mx__v { position: relative; margin: 0; font-family: var(--f-title); font-weight: 500; font-size: clamp(4.5rem, 13vw, 8.5rem); line-height: 1; letter-spacing: -0.04em; color: var(--cream); font-variant-numeric: tabular-nums; }
  .mx__x { color: var(--gold); font-weight: 400; margin-right: 0.04em; font-size: 0.7em; vertical-align: 0.08em; }
  .mx__line { position: relative; margin: 14px auto 0; max-width: 560px; font-size: clamp(0.92rem, 1.5vw, 1.05rem); color: var(--muted-light); }
  .mx__line :global(strong) { color: var(--cream); font-weight: 500; white-space: nowrap; }
  .sim__note { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 24px; padding: 16px 20px; background: rgba(173, 142, 104, 0.14); border-left: 3px solid var(--gold); border-radius: 2px; font-size: 1rem; color: var(--navy); }
  .sim__note span { display: inline-grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--gold); color: var(--cream); font-size: 0.8rem; margin-top: 1px; }
  .cmp :global(.cmp__mx) { margin: -4px 0 18px; padding: 14px 16px; background: var(--sand); border-radius: 2px; }
  .cmp :global(.cmp__mx span) { display: block; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 2px; }
  .cmp :global(.cmp__mx strong) { display: block; font-family: var(--f-title); font-weight: 500; font-size: clamp(2.4rem, 4vw, 3.1rem); line-height: 1.05; letter-spacing: -0.03em; color: var(--navy); }
  .cmp :global(.cmp__card.is-best .cmp__mx) { background: var(--navy); }
  .cmp :global(.cmp__card.is-best .cmp__mx span) { color: var(--gold-light); }
  .cmp :global(.cmp__card.is-best .cmp__mx strong) { color: var(--cream); }
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 32px; }
  .kpis :global(div) { background: var(--navy); color: var(--cream); padding: 22px 20px; border-radius: var(--radius); }
  .kpis :global(span) { display: block; font-size: 0.78rem; color: var(--muted-light); margin-bottom: 8px; }
  .kpis :global(strong) { font-family: var(--f-title); font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 1.9rem); color: var(--gold-light); letter-spacing: -0.02em; }
  @media (max-width: 760px) { .kpis { grid-template-columns: 1fr 1fr; } }
  .sim__table :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .sim__table :global(td) { padding: 13px 0; border-bottom: 1px solid var(--line); }
  .sim__table :global(td:first-child) { color: var(--muted); }
  .sim__table :global(td:last-child) { text-align: right; color: var(--navy); font-weight: 400; }
  .sim__table :global(tr.is-key td) { font-weight: 500; color: var(--navy); }
  .sim__table :global(.neg) { color: #a3442c !important; }
  .sim__foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; flex-wrap: wrap; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  .sim__hyp-t { font-family: var(--f-title); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 8px; }
  .sim__hyp { margin: 0 0 10px; padding-left: 18px; font-size: 0.84rem; color: var(--muted); max-width: 680px; }
  .sim__disc { font-size: 0.78rem; color: var(--muted); margin: 0; }
</style>

<script>
  import { simulate, CREDIT_RATE, type SimInput, type Result } from '../scripts/sim-core';

  const LOCALE: Record<string, string> = { fr: 'fr-CH', en: 'en-GB', de: 'de-CH' };

  document.querySelectorAll<HTMLElement>('[data-sim]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.cfg!);
    const ui = cfg.ui;
    const loc = LOCALE[cfg.lang];
    const params = root.querySelector<HTMLFormElement>('[data-params]')!;
    const lead = root.querySelector<HTMLElement>('[data-lead]')!;
    const leadForm = root.querySelector<HTMLFormElement>('[data-leadform]')!;
    const res = root.querySelector<HTMLElement>('[data-res]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const errEl = root.querySelector<HTMLElement>('[data-err]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const IDENT_KEY = 'ef-sim-ident';

    const radio = (n: string) => (params.querySelector(`input[name=${n}]:checked`) as HTMLInputElement).value;
    const num = (n: string) => { const v = parseFloat((params.elements.namedItem(n) as HTMLInputElement).value); return isFinite(v) ? v : 0; };
    const nf = (v: number, d = 0) => new Intl.NumberFormat(loc, { maximumFractionDigits: d, minimumFractionDigits: d }).format(v);
    const money = (v: number, cur: string, l = loc) => new Intl.NumberFormat(l, { style: 'currency', currency: cur, currencyDisplay: 'code', maximumFractionDigits: 0 }).format(Math.round(v));
    const pct = (v: number, l = loc) => (isFinite(v) ? new Intl.NumberFormat(l, { style: 'percent', maximumFractionDigits: 1 }).format(v) : '—');
    const months = (m: number) => {
      if (m < 24 || m % 12) return `${nf(m)} ${ui.months_unit}`;
      const y = m / 12; return `${nf(y)} ${y > 1 ? ui.years_unit : ui.year_unit}`;
    };
    const fmt: Record<string, (v: number) => string> = {
      pct: (v) => `${nf(v, v % 1 ? 1 : 0)} %`,
      months,
      delivery: (v) => (v === 0 ? ui.deliveryNow : months(v)),
      count: (v) => `${nf(v)}`,
      years: (v) => `${nf(v)} ${v > 1 ? ui.years_unit : ui.year_unit}`,
    };

    function paintSlider(r: HTMLInputElement) {
      const p = ((+r.value - +r.min) / (+r.max - +r.min)) * 100;
      r.style.setProperty('--p', p + '%');
      const out = root.querySelector(`[data-out="${r.name}"]`);
      if (out) out.textContent = fmt[r.dataset.fmt!](+r.value);
      if (r.name === 'yieldPct') {
        const v = +r.value;
        root.querySelectorAll<HTMLElement>('[data-zone]').forEach((z) => z.classList.remove('is-on'));
        let badge = ui.zoneHigh;
        if (v < 6) badge = ui.zoneLow;
        else if (v <= 10) { badge = ui.zoneLong; root.querySelector('[data-zone=long]')?.classList.add('is-on'); }
        if (v >= 10 && v <= 15) { badge = v === 10 ? `${ui.zoneLong} · ${ui.zoneShort}` : ui.zoneShort; root.querySelector('[data-zone=short]')?.classList.add('is-on'); }
        root.querySelector('[data-badge]')!.textContent = badge;
      }
    }
    const mode = () => radio('mode') as 'price' | 'budget';
    const currency = () => (mode() === 'budget' ? radio('currencyB') : radio('currency'));
    function syncVisibility() {
      const f = radio('financing');
      const s = radio('strategy');
      const md = mode();
      root.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== md));
      root.querySelectorAll<HTMLElement>('[data-fin]').forEach((el) => (el.hidden = md === 'price' && el.dataset.fin !== f));
      root.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => (el.hidden = el.dataset.only !== s));
      root.querySelectorAll('[data-cur]').forEach((e) => (e.textContent = currency()));
    }
    params.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((r) => { paintSlider(r); r.addEventListener('input', () => paintSlider(r)); });
    params.querySelectorAll('input[name=financing], input[name=strategy], input[name=mode], input[name=currency], input[name=currencyB]').forEach((r) => r.addEventListener('change', () => { syncVisibility(); res.hidden = true; lead.hidden = true; }));
    const budgetIn = params.elements.namedItem('budget') as HTMLInputElement;
    const paintChips = () => root.querySelectorAll<HTMLElement>('[data-budget]').forEach((c) => c.classList.toggle('is-on', +c.dataset.budget! === +budgetIn.value));
    root.querySelectorAll<HTMLElement>('[data-budget]').forEach((c) => c.addEventListener('click', () => { budgetIn.value = c.dataset.budget!; paintChips(); }));
    budgetIn.addEventListener('input', paintChips); paintChips();
    syncVisibility();

    function read() {
      const x: SimInput = {
        financing: radio('financing') as SimInput['financing'],
        strategy: radio('strategy') as SimInput['strategy'],
        price: num('price'), notary: cfg.notary[currency()] ?? 0,
        delivery: num('delivery'), holding: num('holding'),
        yieldPct: num('yieldPct'), apprPct: num('apprPct'),
        planDown: num('planDown'), planMonths: num('planMonths'),
        creditDown: num('creditDown'), creditYears: num('creditYears'),
      };
      return { x, cur: currency(), finish: radio('finish'), budget: num('budget') };
    }

    /** Mode « budget » : prix maximal finançable pour un capital mobilisé égal au budget, pour chaque financement */
    type Opt = { f: SimInput['financing']; x: SimInput; r: Result };
    function solveBudget(p: ReturnType<typeof read>): Opt[] {
      return (['cash', 'plan', 'credit'] as const).map((f) => {
        const base = { ...p.x, financing: f };
        let lo = 0, hi = Math.max(p.budget, 1) * 25;
        for (let i = 0; i < 60; i++) {
          const mid = (lo + hi) / 2;
          if (simulate({ ...base, price: mid }).capital <= p.budget) lo = mid; else hi = mid;
        }
        const price = Math.floor(lo / 1000) * 1000;
        const x = { ...base, price };
        return { f, x, r: simulate(x) };
      }).filter((o) => o.x.price > 0);
    }
    const bestOf = (opts: Opt[]) => opts.reduce((a, b) => (b.r.roe > a.r.roe ? b : a), opts[0]);
    const tpl = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
    const label = (group: string, v: string) => (params.querySelector(`input[name=${group}][value=${v}]`)?.nextElementSibling as HTMLElement)?.textContent?.trim() ?? v;
    const finLabel = (v: string) => (params.querySelector(`input[name=financing][value=${v}]`)?.nextElementSibling?.querySelector('strong') as HTMLElement)?.textContent ?? v;

    const kpisEl = root.querySelector<HTMLElement>('[data-kpis]')!;
    const tableEl = root.querySelector<HTMLElement>('[data-table]')!;
    const cmpEl = root.querySelector<HTMLElement>('[data-cmp]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-res-title]')!;
    const mxLabel = root.querySelector<HTMLElement>('[data-mx-label]')!;
    const mxVal = root.querySelector<HTMLElement>('[data-mx-val]')!;
    const mxLine = root.querySelector<HTMLElement>('[data-mx-line]')!;
    function paintMultiple(label: string, r: Result, cur: string, holding: number) {
      mxLabel.textContent = label;
      mxVal.textContent = nf(r.multiple, 2);
      mxLine.innerHTML = tpl(ui.mxLine, { capital: `<strong>${money(r.capital, cur)}</strong>`, final: `<strong>${money(r.capital + r.gain, cur)}</strong>`, holding: months(holding) });
    }

    function renderBudget(p: ReturnType<typeof read>, opts: Opt[]) {
      const m = (v: number) => money(v, p.cur);
      const best = bestOf(opts);
      kpisEl.hidden = true; tableEl.hidden = true; cmpEl.hidden = false;
      titleEl.textContent = tpl(ui.resultsBudget, { budget: m(p.budget) });
      paintMultiple(tpl(ui.mxBest, { fin: finLabel(best.f) }), best.r, p.cur, p.x.holding);
      root.querySelector('[data-res-tag]')!.textContent = `${label('strategy', p.x.strategy)} · ${label('finish', p.finish)} · ${months(p.x.holding)}`;
      cmpEl.innerHTML = `<p class="cmp__lead">${ui.cmpLead}</p><div class="cmp__grid">` + opts.map((o) => {
        const rows: [string, string, string?][] = [];
        rows.push([ui.netGain, m(o.r.gain)]);
        rows.push([ui.irr, pct(o.r.irr)]);
        if (o.f !== 'cash') rows.push([ui.cmpMonthly, m(o.r.monthly)]);
        if (p.x.strategy === 'rent') rows.push([ui.cmpCashflow, m(o.r.cashflow), o.r.cashflow < 0 ? 'neg' : '']);
        return `<article class="cmp__card${o === best ? ' is-best' : ''}">${o === best ? `<span class="cmp__badge">${ui.bestRoe}</span>` : ''}
          <h4>${finLabel(o.f)}</h4>
          <div class="cmp__mx"><span>${ui.mxCard}</span><strong>×${nf(o.r.multiple, 2)}</strong></div>
          <div class="cmp__big"><span>${ui.reachPrice}</span><strong>${m(o.x.price)}</strong></div>
          <div class="cmp__big"><span>${ui.roe}</span><strong>${pct(o.r.roe)}</strong></div>
          <div class="cmp__big"><span>${ui.capitalAfter}</span><strong>${m(o.r.capital + o.r.gain)}</strong></div>
          <ul class="cmp__rows">${rows.map(([k, v, c]) => `<li><span>${k}</span><b class="${c || ''}">${v}</b></li>`).join('')}</ul>
        </article>`;
      }).join('') + '</div>';
      const hyp = [p.x.strategy === 'rent' ? ui.hypRent : ui.hypResale, ui.hypPlan, ui.hypRate, ui.hypTax];
      root.querySelector('[data-hyp]')!.innerHTML = hyp.map((h) => `<li>${h}</li>`).join('');
    }

    function render(p: ReturnType<typeof read>, r: Result) {
      kpisEl.hidden = false; tableEl.hidden = false; cmpEl.hidden = true;
      titleEl.textContent = ui.results;
      const { x, cur } = p;
      paintMultiple(ui.mxLabel, r, cur, x.holding);
      const m = (v: number) => money(v, cur);
      root.querySelector('[data-res-tag]')!.textContent = `${finLabel(x.financing)} · ${label('strategy', x.strategy)} · ${label('finish', p.finish)}`;
      root.querySelector('[data-kpis]')!.innerHTML = [
        [ui.capital, m(r.capital)], [ui.netGain, m(r.gain)], [ui.roe, pct(r.roe)], [ui.irr, pct(r.irr)],
      ].map(([k, v]) => `<div><span>${k}</span><strong>${v}</strong></div>`).join('');
      const rows: [string, string, string?][] = [[ui.priceRow, m(x.price)]];
      if (x.financing !== 'cash') rows.push([ui.downRow, m(r.down)]);
      if (x.financing === 'credit') rows.push([ui.loanRow, m(r.loan)]);
      if (x.financing !== 'cash') rows.push([ui.monthly, m(r.monthly)]);
      if (x.strategy === 'rent') {
        rows.push([ui.cashflow, m(r.cashflow), r.cashflow < 0 ? 'neg' : '']);
        rows.push([ui.rents, m(r.rents)]);
      }
      if (x.financing === 'credit') rows.push([ui.repayments, m(r.repayments)]);
      rows.push([ui.saleValue, m(r.sale)]);
      rows.push([ui.tax, r.tax > 0 ? m(r.tax) : ui.none]);
      if (r.debtLeft > 0) rows.push([ui.debtLeft, m(r.debtLeft)]);
      root.querySelector('[data-table]')!.innerHTML = `<table><tbody>${rows.map(([k, v, c]) => `<tr class="${c === 'is-key' ? 'is-key' : ''}"><td>${k}</td><td class="${c === 'neg' ? 'neg' : ''}">${v}</td></tr>`).join('')}</tbody></table>`;
      const hyp = [x.strategy === 'rent' ? ui.hypRent : ui.hypResale, ui.hypTax];
      if (x.financing === 'credit') hyp.unshift(ui.hypRate);
      if (x.financing === 'plan') hyp.unshift(ui.hypPlan);
      root.querySelector('[data-hyp]')!.innerHTML = hyp.map((h) => `<li>${h}</li>`).join('');
    }

    /** Résumé en français destiné à l'équipe (e-mail) */
    function summary(p: ReturnType<typeof read>, r: Result, ident: Record<string, string>) {
      const { x, cur } = p;
      const m = (v: number) => money(v, cur, 'fr-CH');
      const fin = { cash: 'Paiement à 100 %', plan: `Plan de paiement — apport ${x.planDown} %, ${x.planMonths} mensualités`, credit: `Crédit bancaire — apport ${x.creditDown} %, ${x.creditYears} ans, taux ${CREDIT_RATE} %` }[x.financing];
      const finish = { brut: 'Brut', turnkey: 'Équipé et meublé' }[p.finish as 'brut'];
      return [
        'NOUVELLE SIMULATION — eric.swiss', '',
        `Client : ${ident.prenom} ${ident.nom}`, `E-mail : ${ident.email}`, `WhatsApp : ${ident.whatsapp}`, `Newsletter : ${ident.newsletter === 'oui' ? 'oui (ajouté à Brevo)' : 'non'}`,
        `Langue du visiteur : ${cfg.lang.toUpperCase()}`, cfg.source ? `Provenance : ${cfg.source}` : '', `Date : ${new Date().toLocaleString('fr-CH')}`, '',
        'PROJET',
        `Financement : ${fin}`,
        `Livraison du logement : ${finish}`,
        `Stratégie : ${x.strategy === 'rent' ? 'Location' : 'Achat / revente'}`,
        `Prix : ${m(x.price)} | Frais de notaire et d’enregistrement : ${m(x.notary)} (inclus dans les calculs)`,
        `Livraison : ${x.delivery} mois | Détention : ${x.holding} mois`,
        x.strategy === 'rent' ? `Rendement locatif net : ${x.yieldPct} %` : 'Rendement locatif : non applicable',
        `Prise de valeur : ${x.apprPct} %/an`, '',
        'RÉSULTATS',
        `Capital mobilisé : ${m(r.capital)}`,
        x.financing !== 'cash' ? `Apport : ${m(r.down)} | Mensualité : ${m(r.monthly)}` : '',
        x.financing === 'credit' ? `Montant du crédit : ${m(r.loan)} | Remboursements cumulés : ${m(r.repayments)}` : '',
        x.strategy === 'rent' ? `Loyers cumulés : ${m(r.rents)} | Cash-flow après livraison : ${m(r.cashflow)}/mois` : '',
        `Valeur de revente : ${m(r.sale)} | Impôt plus-value : ${m(r.tax)} | Solde à rembourser : ${m(r.debtLeft)}`,
        `Gain net : ${m(r.gain)} | ROE : ${pct(r.roe, 'fr-CH')} | Multiple : ${r.multiple.toFixed(2)}× | TRI : ${pct(r.irr, 'fr-CH')}`,
      ].filter((l) => l !== '').join('\n');
    }

    function summaryBudget(p: ReturnType<typeof read>, opts: Opt[], ident: Record<string, string>) {
      const m = (v: number) => money(v, p.cur, 'fr-CH');
      const finish = { brut: 'Brut', turnkey: 'Équipé et meublé' }[p.finish as 'brut'];
      const best = bestOf(opts);
      const names = { cash: 'Paiement à 100 %', plan: `Plan de paiement (apport ${p.x.planDown} %, ${p.x.planMonths} mensualités)`, credit: `Crédit bancaire (apport ${p.x.creditDown} %, ${p.x.creditYears} ans, taux ${CREDIT_RATE} %)` };
      return [
        'NOUVELLE SIMULATION (MODE BUDGET) — eric.swiss', '',
        `Client : ${ident.prenom} ${ident.nom}`, `E-mail : ${ident.email}`, `WhatsApp : ${ident.whatsapp}`, `Newsletter : ${ident.newsletter === 'oui' ? 'oui (ajouté à Brevo)' : 'non'}`,
        `Langue du visiteur : ${cfg.lang.toUpperCase()}`, cfg.source ? `Provenance : ${cfg.source}` : '', `Date : ${new Date().toLocaleString('fr-CH')}`, '',
        'PROJET',
        `Fonds propres disponibles : ${m(p.budget)}`,
        `Livraison du logement : ${finish}`,
        `Stratégie : ${p.x.strategy === 'rent' ? 'Location' : 'Achat / revente'}`,
        `Livraison : ${p.x.delivery} mois | Détention : ${p.x.holding} mois`,
        p.x.strategy === 'rent' ? `Rendement locatif net : ${p.x.yieldPct} %` : 'Rendement locatif : non applicable',
        `Prise de valeur : ${p.x.apprPct} %/an | Frais de notaire et d’enregistrement : ${m(p.x.notary)} (inclus)`, '',
        'OPTIONS COMPARÉES',
        ...opts.map((o) => `${names[o.f]}${o === best ? ' — MEILLEUR ROE' : ''}\n  Bien accessible : ${m(o.x.price)} | Gain net : ${m(o.r.gain)} | ROE : ${pct(o.r.roe, 'fr-CH')} | TRI : ${pct(o.r.irr, 'fr-CH')} | Multiple : ${o.r.multiple.toFixed(2)}×${o.f !== 'cash' ? ` | Mensualité : ${m(o.r.monthly)}` : ''}${p.x.strategy === 'rent' ? ` | Cash-flow : ${m(o.r.cashflow)}/mois` : ''}`),
      ].filter((l) => l !== '').join('\n');
    }

    async function send(ident: Record<string, string>, text: string) {
      if (cfg.form.provider === 'web3forms' && cfg.form.key) {
        const r = await fetch('https://api.web3forms.com/submit', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ access_key: cfg.form.key, subject: `Simulation eric.swiss — ${ident.prenom} ${ident.nom}`, from_name: 'eric.swiss', replyto: ident.email, ...ident, langue: cfg.lang, simulation: text }),
        });
        if (!r.ok) throw new Error('send');
        return;
      }
      const body = new URLSearchParams({ 'form-name': 'simulation', langue: cfg.lang, resume: text, ...ident, consentement: 'oui' });
      const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() });
      if (!r.ok) throw new Error('send');
    }

    /** Numéro au format international obligatoire : +<indicatif><numéro> (00 accepté et converti en +) */
    const intlPhone = (v: string): string | null => {
      let n = v.replace(/[\s().\-\/]/g, '');
      n = n.replace(/^\++/, '+'); // « ++41… » (collé après le « + » ajouté au focus)
      if (n.startsWith('00')) n = '+' + n.slice(2);
      if (n.startsWith('+00')) n = '+' + n.slice(3);
      return /^\+[1-9]\d{6,14}$/.test(n) ? n : null;
    };
    const getIdent = (): Record<string, string> | null => {
      try { const i = JSON.parse(sessionStorage.getItem(IDENT_KEY) || 'null'); return i && intlPhone(i.whatsapp || '') ? { newsletter: 'non', ...i } : null; } catch { return null; }
    };
    function showStatus(ok: boolean) { statusEl.hidden = false; statusEl.textContent = ok ? ui.sent : ui.error; statusEl.classList.toggle('is-err', !ok); }

    async function deliver(ident: Record<string, string>) {
      const p = read();
      let text: string;
      if (mode() === 'budget') {
        const opts = solveBudget(p);
        renderBudget(p, opts);
        text = summaryBudget(p, opts, ident);
      } else {
        const r = simulate(p.x);
        render(p, r);
        text = summary(p, r, ident);
      }
      lead.hidden = true; res.hidden = false;
      res.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try { await send(ident, text); showStatus(true); } catch { showStatus(false); }
    }
    const teaserEl = root.querySelector<HTMLElement>('[data-teaser]')!;
    function teaser() {
      const p = read();
      if (mode() === 'budget') {
        const opts = solveBudget(p);
        const max = Math.max(...opts.map((o) => o.x.price));
        teaserEl.innerHTML = tpl(ui.teaserBudget, { budget: `<strong>${money(p.budget, p.cur)}</strong>`, price: `<strong>${money(max, p.cur)}</strong>` });
      } else teaserEl.textContent = ui.teaserPrice;
    }

    params.addEventListener('submit', (e) => {
      e.preventDefault();
      const ident = getIdent();
      if (ident) { deliver(ident); return; }
      res.hidden = true; lead.hidden = false;
      teaser();
      lead.scrollIntoView({ behavior: 'smooth', block: 'start' });
      (leadForm.elements.namedItem('prenom') as HTMLInputElement).focus({ preventScroll: true });
    });

    const phoneIn = leadForm.elements.namedItem('whatsapp') as HTMLInputElement;
    phoneIn.addEventListener('focus', () => { if (!phoneIn.value) phoneIn.value = '+'; });
    phoneIn.addEventListener('blur', () => { if (phoneIn.value.trim() === '+') phoneIn.value = ''; });

    leadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(leadForm);
      if ((fd.get('bot-field') as string)?.length) return;
      const ident = { prenom: String(fd.get('prenom') || '').trim(), nom: String(fd.get('nom') || '').trim(), email: String(fd.get('email') || '').trim(), whatsapp: String(fd.get('whatsapp') || '').trim(), newsletter: fd.get('newsletter') ? 'oui' : 'non' };
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(ident.email);
      if (!ident.prenom || !ident.nom || !emailOk || !ident.whatsapp || !fd.get('consentement')) { errEl.textContent = ui.required; errEl.hidden = false; return; }
      const phone = intlPhone(ident.whatsapp);
      if (!phone) { errEl.textContent = ui.phoneIntl; errEl.hidden = false; (leadForm.elements.namedItem('whatsapp') as HTMLInputElement).focus(); return; }
      ident.whatsapp = phone;
      errEl.hidden = true;
      submitBtn.disabled = true; submitBtn.textContent = ui.sending;
      try { sessionStorage.setItem(IDENT_KEY, JSON.stringify(ident)); } catch {}
      await deliver(ident);
      submitBtn.disabled = false; submitBtn.innerHTML = `${ui.submit} <span class="arrow">→</span>`;
    });

    root.querySelector('[data-edit]')!.addEventListener('click', () => params.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  });
</script>
