---
import { SOCIAL } from '../config/site';
interface Props { class?: string }
const { class: cls } = Astro.props;
const icons: Record<string, { label: string; svg: string }> = {
  linkedin: { label: 'LinkedIn', svg: '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.13V21h-4v-4.95c0-1.18-.02-2.7-1.65-2.7-1.65 0-1.9 1.29-1.9 2.62V21h-4V9.75Z"/>' },
  instagram: { label: 'Instagram', svg: '<path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.75a3.05 3.05 0 1 1 0-6.1 3.05 3.05 0 0 1 0 6.1Zm4.9-8.95a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM12 3c-2.44 0-2.75.01-3.71.05-3.27.15-5.09 1.97-5.24 5.24C3.01 9.25 3 9.56 3 12s.01 2.75.05 3.71c.15 3.27 1.97 5.09 5.24 5.24.96.04 1.27.05 3.71.05s2.75-.01 3.71-.05c3.26-.15 5.1-1.97 5.24-5.24.04-.96.05-1.27.05-3.71s-.01-2.75-.05-3.71c-.15-3.26-1.97-5.09-5.24-5.24C14.75 3.01 14.44 3 12 3Zm0 1.62c2.4 0 2.69.01 3.64.05 2.44.11 3.58 1.27 3.69 3.69.04.95.05 1.24.05 3.64s-.01 2.69-.05 3.64c-.11 2.42-1.25 3.58-3.69 3.69-.95.04-1.24.05-3.64.05s-2.69-.01-3.64-.05c-2.45-.11-3.58-1.27-3.69-3.69-.04-.95-.05-1.24-.05-3.64s.01-2.69.05-3.64c.11-2.42 1.25-3.58 3.69-3.69.95-.04 1.24-.05 3.64-.05Z"/>' },
  tiktok: { label: 'TikTok', svg: '<path d="M16.6 3c.3 2.1 1.6 3.6 3.9 3.8v2.9c-1.4.1-2.7-.3-3.9-1.1v5.7c0 4.9-5.3 6.9-8.3 3.9-2.6-2.6-1.6-7.9 3.6-7.9v3c-2.6-.3-3.4 1.6-2.7 2.9.8 1.4 4.2 1.5 4.2-1.9V3h3.2Z"/>' },
  youtube: { label: 'YouTube', svg: '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77C22 15.2 22 12 22 12s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"/>' },
};
const links = (Object.entries(SOCIAL) as [string, string][])
  .filter(([, url]) => url)
  .map(([k, url]) => ({ url, ...icons[k.replace(/\d+$/, '')] }));
---
{links.length > 0 && (
  <ul class:list={['soc', cls]}>
    {links.map((l) => (
      <li><a href={l.url} target="_blank" rel="noopener me" aria-label={l.label} title={l.label}><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={l.svg} /></a></li>
    ))}
  </ul>
)}
<style>
  .soc { list-style: none; display: flex; gap: 10px; padding: 0; margin: 0; }
  .soc a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line-light); border-radius: 50%; color: var(--gold-light); transition: all 0.3s var(--ease); }
  .soc a:hover { background: var(--gold); border-color: var(--gold); color: var(--cream); }
</style>
