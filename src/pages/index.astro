---
/**
 * Page racine eric.swiss/ : redirige le visiteur vers sa langue.
 * 1) langue déjà choisie (mémorisée)  2) langue du navigateur  3) anglais par défaut.
 * Option côté serveur : voir public/_redirects.
 */
import { LANGS, SITE, absolute, path } from '../config/site';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eric Fankhauser</title>
    <meta name="description" content="Real estate investment in Georgia, strategic consulting and Advisory Board — Eric Fankhauser." />
    <link rel="canonical" href={SITE.url + '/'} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(path('home', l))} />)}
    <link rel="alternate" hreflang="x-default" href={SITE.url + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#112150" />
    <script is:inline>
      (function () {
        var supported = ['fr', 'en', 'de'];
        var lang = null;
        try { lang = localStorage.getItem('ef-lang'); } catch (e) {}
        if (supported.indexOf(lang) < 0) {
          lang = 'en';
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < prefs.length; i++) {
            var code = String(prefs[i]).slice(0, 2).toLowerCase();
            if (supported.indexOf(code) >= 0) { lang = code; break; }
          }
        }
        location.replace('/' + lang + '/' + location.search + location.hash);
      })();
    </script>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #112150; color: #fffefb; font-family: system-ui, sans-serif; }
      nav { display: flex; gap: 24px; } a { color: #cbb291; letter-spacing: .1em; text-decoration: none; }
      img { width: 260px; margin: 0 auto 32px; display: block; }
    </style>
  </head>
  <body>
    <div>
      <img src="/images/sign-gold.svg" alt="Eric Fankhauser" style="width:110px" />
      <nav><a href="/fr/" hreflang="fr">Français</a><a href="/en/" hreflang="en">English</a><a href="/de/" hreflang="de">Deutsch</a></nav>
    </div>
  </body>
</html>
