---
/**
 * Page d'atterrissage « Bilan immobilier » (propriétaires en France).
 * 1. Prise de rendez-vous — 2. Pourquoi maintenant — 3. Ce que comprend le bilan.
 * Textes : src/content/pages/fr/bilan.yaml. Agenda : CALENDLY.bilan (src/config/site.ts).
 */
import Calendly from '../components/Calendly.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import { SITE, CALENDLY, PHOTOS, path } from '../config/site';
import { page } from '../lib/content';
const lang = 'fr';
const d = await page(lang, 'bilan');
const l = await page(lang, 'landing');
const anchors = ['rdv', 'contexte', 'capital', 'bilan'];
const HUGO = '/images/photos/hugo-viard.jpg';
const year = new Date().getFullYear();
const wa = `https://wa.me/${SITE.whatsapp}`;
---
<section class="lhero">
  <img class="lhero__mark" src="/images/sign-gold.svg" alt="" aria-hidden="true" width="540" height="340" />
  <div class="wrap lhero__in">
    <div class="lhero__txt">
      <div class="lhero__me">
        <div class="lhero__ph"><Photo src={PHOTOS.heroPortrait} alt={l.hero.person} ratio="1 / 1" position="50% 18%" eager /></div>
        <p><strong>{l.hero.person}</strong><span>{l.hero.role}</span></p>
      </div>
      <p class="eyebrow">{d.hero.eyebrow}</p>
      <h1 set:html={d.hero.title} />
      <p class="lead">{d.hero.lead}</p>
      <ul class="lhero__proofs">{d.hero.proofs.map((p: string) => <li>{p}</li>)}</ul>
      <ol class="lsteps">
        {d.steps.map((s: string, i: number) => <li><a href={`#${anchors[i]}`}><span>{i + 1}</span>{s}</a></li>)}
      </ol>
    </div>
    <div class="lhero__cal lsec" id="rdv">
      <p class="lhero__calt"><span class="lnum">1</span>{d.booking.title}</p>
      <p class="lhero__with"><img src={HUGO} alt={d.hugo.name} width="40" height="40" />{d.booking.with}</p>
      <Calendly url={CALENDLY.bilan} lang={lang} height={600} />
    </div>
  </div>
</section>

<section class="section section--navy lsec" id="contexte">
  <div class="wrap">
    <div class="lhead reveal">
      <span class="lnum">2</span>
      <div><h2>{d.context.title}</h2><p class="lead">{d.context.text}</p></div>
    </div>
    <dl class="lstats lstats--4">
      {d.context.stats.map((s: any, i: number) => (
        <div class="reveal" style={`transition-delay:${i * 60}ms`}><dt>{s.value}</dt><dd>{s.label}</dd></div>
      ))}
    </dl>
    <p class="lsub reveal">{d.context.questionsTitle}</p>
    <div class="lreasons">
      {d.context.questions.map((r: any, i: number) => (
        <article class="reveal" style={`transition-delay:${i * 80}ms`}>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
    <p class="lsrc">{d.sources}</p>
    <a class="link lguide" href="/fr/france-ou-georgie/">{d.guide} <span class="arrow">→</span></a>
  </div>
</section>

<section class="section lsec" id="capital">
  <div class="wrap">
    <div class="lhead reveal">
      <span class="lnum">3</span>
      <div><h2>{d.capital.title}</h2><p class="lead">{d.capital.text}</p></div>
    </div>
    <div class="cap">
      <div class="cap__pts">
        {d.capital.points.map((pt: any, i: number) => (
          <article class="reveal" style={`transition-delay:${i * 70}ms`}><h3>{pt.title}</h3><p>{pt.text}</p></article>
        ))}
      </div>
      <form class="calc reveal" data-calc onsubmit="return false">
        <p class="calc__t">{d.capital.calc.title}</p>
        <label><span>{d.capital.calc.value}</span><input type="text" inputmode="numeric" name="v" value="250 000" /></label>
        <label><span>{d.capital.calc.debt}</span><input type="text" inputmode="numeric" name="d" value="70 000" /></label>
        <label><span>{d.capital.calc.gain}</span><input type="text" inputmode="numeric" name="g" value="7 000" /><small>{d.capital.calc.gainHint}</small></label>
        <dl class="calc__out">
          <div><dt>{d.capital.calc.out.capital}</dt><dd data-o="cap">—</dd></div>
          <div class="is-key"><dt>{d.capital.calc.out.yield}</dt><dd data-o="y">—</dd></div>
          <div><dt>{d.capital.calc.out.drop}</dt><dd data-o="drop">—</dd></div>
          <div><dt>{d.capital.calc.out.ltv}</dt><dd data-o="ltv">—</dd></div>
        </dl>
        <p class="calc__v" data-o="verdict"></p>
        <a class="btn" href="#rdv">{d.final.book} <span class="arrow">↑</span></a>
        <p class="calc__n">{d.capital.calc.note}</p>
      </form>
    </div>
    <p class="lsub reveal">{d.capital.pitfalls.title}</p>
    <div class="pits">
      {d.capital.pitfalls.items.map((it: any, i: number) => (
        <article class="reveal" style={`transition-delay:${i * 70}ms`}><h3>{it.title}</h3><p>{it.text}</p></article>
      ))}
    </div>
  </div>
</section>

<section class="section section--sand lsec" id="bilan">
  <div class="wrap">
    <div class="lhead reveal">
      <span class="lnum">4</span>
      <div><h2>{d.bilan.title}</h2><p class="lead">{d.bilan.text}</p></div>
    </div>
    <div class="hugo reveal">
      <img src={HUGO} alt={d.hugo.name} width="120" height="120" loading="lazy" />
      <div><p class="hugo__n"><strong>{d.hugo.name}</strong><span>{d.hugo.role}</span></p><p>{d.hugo.text}</p></div>
    </div>
    <div class="bitems">
      {d.bilan.items.map((it: any, i: number) => (
        <article class="reveal" style={`transition-delay:${i * 60}ms`}>
          <span class="bitems__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))}
      <aside class="bprep reveal">
        <p class="eyebrow">{d.bilan.prepareTitle}</p>
        <ul>{d.bilan.prepare.map((x: string) => <li>{x}</li>)}</ul>
        <a class="btn" href="#rdv">{d.final.book} <span class="arrow">↑</span></a>
      </aside>
    </div>
  </div>
</section>

<section class="section lsec">
  <div class="wrap">
    <h2 class="bhow__t reveal">{d.how.title}</h2>
    <ol class="bhow">
      {d.how.steps.map((s: any, i: number) => (
        <li class="reveal" style={`transition-delay:${i * 80}ms`}><span class="lnum">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>

<section class="section lsec">
  <div class="wrap lteam">
    <div class="reveal">
      <p class="eyebrow">{d.team.eyebrow}</p>
      <h2>{d.team.title}</h2>
      <p class="lead">{d.team.text}</p>
      <a class="link" href={path('invest', lang)}>FFI · Real Estate Asset Management <span class="arrow">→</span></a>
    </div>
    {PHOTOS.team && <div class="reveal"><Photo src={PHOTOS.team} alt={d.team.title} ratio="4 / 3" position="50% 28%" /></div>}
  </div>
</section>

<Faq eyebrow={d.faq.eyebrow} title={d.faq.title} items={d.faq.items} sand />

<section class="section section--navy lfinal">
  <div class="wrap reveal">
    <h2>{d.final.title}</h2>
    <p class="lead">{d.final.text}</p>
    <div class="lfinal__btns">
      <a class="btn" href="#rdv">{d.final.book} <span class="arrow">↑</span></a>
      <a class="btn btn--ghost" href={wa} target="_blank" rel="noopener">{d.final.whatsapp}</a>
    </div>
  </div>
</section>

<div class="lsticky" data-sticky>
  <a class="btn" href="#rdv">{d.final.book}</a>
  <a class="lsticky__wa" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">WhatsApp</a>
</div>

<footer class="lfoot">
  <div class="wrap lfoot__in">
    <span>© {year} Eric Fankhauser · <a href={path('home', lang)}>eric.swiss</a></span>
    <span><a href={path('legal', lang)}>Mentions légales</a> · <a href={path('privacy', lang)}>Confidentialité</a></span>
  </div>
</footer>

<style>
  .lhero { position: relative; overflow: hidden; background: var(--navy); color: var(--cream); }
  .lhero__mark { position: absolute; left: -8%; bottom: -20%; width: min(40vw, 520px); height: auto; opacity: 0.06; pointer-events: none; }
  .lhero__in { position: relative; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 60px); align-items: start; padding-top: clamp(28px, 4vw, 52px); padding-bottom: clamp(32px, 4vw, 56px); }
  .lhero h1 { font-weight: 400; font-size: clamp(1.9rem, 3.6vw, 3rem); margin-bottom: 18px; }
  .lhero h1 :global(em) { font-style: normal; color: var(--gold-light); }
  .lhero .lead { color: var(--muted-light); font-size: 1.02rem; }
  .lhero__proofs { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lhero__proofs li { font-size: 0.8rem; padding: 6px 13px; border: 1px solid rgba(173, 142, 104, 0.45); border-radius: 999px; color: var(--gold-light); }
  .lhero__me { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
  .lhero__ph { width: 64px; flex: none; border-radius: 50%; overflow: hidden; border: 2px solid var(--gold); }
  .lhero__ph :global(.ph) { border-radius: 50%; }
  .lhero__me p { display: flex; flex-direction: column; gap: 2px; font-size: 0.9rem; margin: 0; }
  .lhero__me span { color: var(--muted-light); font-size: 0.8rem; }
  .lhero__cal { background: var(--cream); color: var(--navy); border-radius: var(--radius); padding: 18px 18px 4px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28); }
  .lhero__cal :global(.cal) { border: 0; }
  .lhero__cal :global(.cal__fallback) { margin: 10px 6px 14px; font-size: 0.72rem; }
  .lhero__calt { display: flex; align-items: center; gap: 12px; margin: 0 0 6px; font-family: var(--f-title); font-size: 1.1rem; }
  .lhero__calt .lnum { width: 32px; height: 32px; font-size: 0.9rem; margin: 0; }
  .lsteps { list-style: none; padding: 0; margin: 36px 0 0; border-top: 1px solid var(--line-light); }
  .lsteps li { border-bottom: 1px solid var(--line-light); }
  .lsteps a { display: flex; align-items: center; gap: 12px; padding: 12px 0; color: var(--cream); text-decoration: none; font-size: 0.9rem; }
  .lsteps a:hover { color: var(--gold-light); }
  .lsteps span, .lnum { display: inline-grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold); font-size: 0.85rem; }
  .lsec { scroll-margin-top: 72px; }
  .lsec.section { padding: clamp(56px, 8vw, 104px) 0; }
  .lhead { display: flex; gap: 20px; align-items: flex-start; margin-bottom: clamp(28px, 4vw, 48px); }
  .lhead .lnum { width: 48px; height: 48px; font-size: 1.15rem; margin-top: 4px; background: var(--cream); }
  .section--navy .lhead .lnum { background: transparent; color: var(--gold-light); }
  .lhead h2 { margin-bottom: 10px; }
  .lreasons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); }
  .lreasons article { background: var(--navy); padding: clamp(24px, 3vw, 36px); }
  .lreasons h3 { font-size: 1.12rem; color: var(--gold-light); margin-bottom: 12px; }
  .lreasons p { color: var(--muted-light); margin: 0; font-size: 0.95rem; }
  .lsub { margin: clamp(48px, 6vw, 72px) 0 20px; font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-light); }
  .lstats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 0; }
  .lstats div { padding: 22px 0; border-top: 1px solid var(--line-light); }
  .lstats dt { font-family: var(--f-title); font-size: clamp(1.9rem, 3.4vw, 2.6rem); color: var(--cream); line-height: 1.1; }
  .lstats dd { margin: 6px 16px 0 0; color: var(--muted-light); font-size: 0.9rem; }
  .lcities { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); margin-top: clamp(40px, 5vw, 64px); }
  .lcities article { border-left: 1px solid var(--gold); padding-left: 24px; }
  .lcities h3 { font-size: 1.6rem; margin: 6px 0 10px; }
  .lcities p:last-child { color: var(--muted-light); margin: 0; }
  .lteam { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .lteam .lead { margin-bottom: 24px; }
  .lfinal { text-align: center; }
  .lfinal .lead { margin: 14px auto 32px; }
  .lfinal__btns { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; }
  .lfoot { background: var(--navy-deep); color: var(--muted-light); font-size: 0.8rem; padding: 22px 0 90px; }
  .lfoot__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  .lfoot a { color: var(--muted-light); }
  .lstats--4 { grid-template-columns: repeat(4, 1fr); margin-bottom: 0; }
  .lstats--4 dd { font-size: 0.86rem; }
  .lsrc { margin: 28px 0 0; font-size: 0.72rem; color: var(--muted-light); opacity: 0.8; }
  .bitems { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .bitems article, .bprep { background: var(--cream); padding: clamp(24px, 3vw, 34px); }
  .bitems__n { display: block; font-family: var(--f-title); font-size: 1.6rem; color: var(--gold); margin-bottom: 14px; }
  .bitems h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .bitems p { color: var(--muted); margin: 0; font-size: 0.95rem; }
  .bprep { background: var(--navy) !important; color: var(--cream); display: flex; flex-direction: column; gap: 14px; }
  .bprep .eyebrow { color: var(--gold-light); margin: 0; }
  .bprep ul { margin: 0; padding-left: 18px; color: var(--muted-light); font-size: 0.92rem; line-height: 1.7; }
  .bprep .btn { align-self: flex-start; margin-top: auto; }
  .bhow__t { margin-bottom: clamp(28px, 4vw, 44px); }
  .bhow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .bhow .lnum { width: 44px; height: 44px; font-size: 1.05rem; margin-bottom: 18px; }
  .bhow h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .bhow p { color: var(--muted); margin: 0; }
  @media (max-width: 960px) { .lstats--4 { grid-template-columns: 1fr 1fr; } .bitems { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .bitems, .bhow { grid-template-columns: 1fr; } }
  .lhero__with { display: flex; align-items: center; gap: 10px; margin: 2px 0 8px; font-size: 0.82rem; color: var(--muted); }
  .lhero__with img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
  .lguide { display: inline-flex; margin-top: 18px; color: var(--gold-light); }
  .cap { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 56px); align-items: start; }
  .cap__pts article { padding: 0 0 22px 22px; border-left: 2px solid var(--gold); margin-bottom: 22px; }
  .cap__pts h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .cap__pts p { color: var(--muted); margin: 0; }
  .calc { background: var(--navy); color: var(--cream); border-radius: var(--radius); padding: clamp(22px, 3vw, 32px); display: flex; flex-direction: column; gap: 12px; box-shadow: 0 30px 70px -35px rgba(17, 33, 80, 0.6); }
  .calc__t { font-family: var(--f-title); font-size: 1.2rem; margin: 0 0 4px; }
  .calc label { display: flex; flex-direction: column; gap: 5px; font-size: 0.8rem; color: var(--gold-light); }
  .calc input { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.2); border-radius: 2px; color: var(--cream); padding: 11px 12px; font: inherit; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .calc input:focus { outline: none; border-color: var(--gold); }
  .calc small { color: var(--muted-light); font-size: 0.72rem; }
  .calc__out { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,0.12); margin: 8px 0 0; border: 1px solid rgba(255,255,255,0.12); }
  .calc__out div { background: var(--navy); padding: 12px 14px; }
  .calc__out dt { font-size: 0.72rem; color: var(--muted-light); margin-bottom: 4px; }
  .calc__out dd { margin: 0; font-family: var(--f-title); font-size: 1.35rem; font-variant-numeric: tabular-nums; }
  .calc__out .is-key dd { color: var(--gold-light); }
  .calc__out dd.neg { color: #f0a58f; }
  .calc__v { font-size: 0.88rem; color: var(--muted-light); margin: 2px 0; min-height: 2.6em; }
  .calc .btn { align-self: flex-start; }
  .calc__n { font-size: 0.72rem; color: var(--muted-light); margin: 0; }
  #capital .lsub { color: var(--gold-deep); }
  .pits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .pits article { border-top: 2px solid var(--gold); padding-top: 18px; }
  .pits h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .pits p { color: var(--muted); margin: 0; font-size: 0.95rem; }
  .hugo { display: flex; gap: 22px; align-items: center; background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; margin-bottom: clamp(24px, 3vw, 36px); }
  .hugo img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 3px solid var(--gold); flex: none; }
  .hugo__n { display: flex; flex-direction: column; margin: 0 0 6px; }
  .hugo__n strong { font-family: var(--f-title); font-size: 1.25rem; color: var(--navy); }
  .hugo__n span { font-size: 0.82rem; color: var(--gold-deep); }
  .hugo p:last-child { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .cap, .pits { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .hugo { flex-direction: column; align-items: flex-start; } }
  .lsticky { display: none; }
  @media (max-width: 960px) { .lreasons { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .lhero__in { grid-template-columns: 1fr; gap: 18px; padding-top: 18px; }
    .lhero__me { margin-bottom: 14px; }
    .lhero__ph { width: 48px; }
    .lhero .eyebrow, .lhero .lead, .lhero__proofs li:nth-child(n+2), .lsteps { display: none; }
    .lhero h1 { font-size: 1.65rem; margin-bottom: 0; }
    .lhero__proofs { margin-top: 12px; }
    .lhero__cal { padding: 12px 8px 2px; margin: 0 calc(var(--gutter) * -0.5); }
    .lhead { gap: 14px; }
    .lhead .lnum { width: 40px; height: 40px; }
    .lreasons, .lstats, .lcities, .lteam { grid-template-columns: 1fr; }
    .lstats { grid-template-columns: 1fr 1fr; }
    .lsticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: flex; gap: 10px; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: rgba(11, 22, 56, 0.96); border-top: 1px solid rgba(173, 142, 104, 0.3); transition: transform 0.35s var(--ease); }
    .lsticky .btn { flex: 1; justify-content: center; }
    .lsticky__wa { display: grid; place-items: center; padding: 0 16px; border-radius: 999px; background: #25d366; color: #fff; text-decoration: none; font-size: 0.85rem; }
    .lsticky.is-hidden { transform: translateY(110%); }
  }
</style>


<script>
  // barre fixe (mobile) : visible seulement hors de l'en-tête et hors de l'agenda
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const watch = [document.querySelector('.lhero'), document.getElementById('rdv')].filter(Boolean) as Element[];
  if (bar) {
    const seen = new Set<Element>();
    bar.classList.add('is-hidden');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      bar.classList.toggle('is-hidden', seen.size > 0);
    }, { threshold: 0.05 });
    watch.forEach((w) => io.observe(w));
  }
</script>

<script define:vars={{ v: d.capital.calc }}>
  (() => {
    const f = document.querySelector('[data-calc]');
    if (!f) return;
    const nf = new Intl.NumberFormat('fr-CH', { maximumFractionDigits: 0 });
    const pf = new Intl.NumberFormat('fr-FR', { style: 'percent', maximumFractionDigits: 1 });
    const num = (n) => +String(f.elements.namedItem(n).value).replace(/[^\d.-]/g, '') || 0;
    const o = (k) => f.querySelector(`[data-o="${k}"]`);
    const run = () => {
      const val = num('v'), debt = num('d'), gain = num('g');
      const cap = val - debt;
      if (val <= 0 || cap <= 0) { ['cap', 'y', 'drop', 'ltv'].forEach((k) => (o(k).textContent = '—')); o('verdict').textContent = ''; return; }
      const y = gain / cap, drop = (gain - 0.05 * val) / cap;
      o('cap').textContent = nf.format(cap) + ' €';
      o('y').textContent = pf.format(y);
      o('drop').textContent = pf.format(drop);
      o('drop').classList.toggle('neg', drop < 0);
      o('ltv').textContent = pf.format(debt / val);
      o('verdict').textContent = y < 0.05 ? v.verdictLow : y < 0.12 ? v.verdictMid : v.verdictHigh;
    };
    f.addEventListener('input', run);
    f.querySelectorAll('input').forEach((i) => i.addEventListener('blur', () => { const n = +i.value.replace(/[^\d]/g, ''); if (n) i.value = nf.format(n); run(); }));
    run();
  })();
</script>
