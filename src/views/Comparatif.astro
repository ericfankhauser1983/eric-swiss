      err: 'Please enter your first name, email and WhatsApp number with country code (e.g. +44 7700 900000).',
      sendErr: 'Sending failed. Please try again or message us on WhatsApp.',
      ok: 'Thank you! Hugo will contact you shortly to set up your review.',
      wa: 'Or message us on WhatsApp', source: 'Guide UK / Georgia (EN)',
    },
    hyp: {
      t: 'Assumptions and sources',
      items: [
        'Example: £200,000 property paid in cash, long-term rental (assured shorthold tenancy), constant rents over 5 years. Illustrative, non-contractual calculation.',
        'UK: average gross yield 5.8% (Zoopla, March 2026); costs 15% of rent (assumption); property income tax at 44% for higher-rate taxpayers from April 2027 (Budget of 28 October 2026, subject to the Finance Bill), on rent after costs; council tax paid by the tenant. House prices −1.2% year on year in October 2026 (Lloyds). Bank Rate 4% (5 November 2026); 5-year fix average 6.00% (Moneyfacts). CGT 18%/24%, £3,000 allowance (GOV.UK).',
        'Georgia: gross yield 8.6% in Tbilisi (Galt & Taggart); costs 10% (assumption); 5% tax on individuals’ rental income. Prices +63.8% since 2020 (Geostat), assumption of +5% a year. Capital gain tax-free after 2 years. TBC Bank loans from 6.3%. Growth 7.2% (IMF, October 2026); positive outlook (Fitch, 30 October 2026); reserves $8.2bn; debt 31.6% of GDP (2027 budget).',
        'Not included: purchase costs (stamp duty incl. 5% second-home surcharge), selling costs and currency effects. Past performance is no guarantee of future results.',
      ],
    },
    sticky: 'My free review', legal: 'Legal notice', privacy: 'Privacy', lessonLabel: 'Key takeaway', back: 'Back to contents',
  },
}[lang];

// Typographie française : espaces insécables dans les nombres et avant € % : ? ;
if (lang === 'fr') {
  const nb = (v: any): any => typeof v === 'string' && !v.startsWith('<svg') ? v.replace(/(\d) (\d{3})/g, '$1 $2').replace(/ ([€%:?;»])/g, ' $1').replace(/« /g, '« ')
    : Array.isArray(v) ? v.map(nb) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, nb(x)])) : v;
  Object.assign(T, nb(T));
}

const year = new Date().getFullYear();
const wa = `https://wa.me/${SITE.whatsapp}`;
const H = 300 / 328400;
const segCol = ['#9aa6bd', '#c9a35c', '#e07a66', ''];
const calc = { lang, cur: T.cur, d: T.c6.d, out: T.c6.out };
const ch = (i: number) => String(i).padStart(2, '0');
