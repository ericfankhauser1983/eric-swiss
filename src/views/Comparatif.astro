<script define:vars={{ msg: { err: T.bilan.err, sendErr: T.bilan.sendErr }, calc }}>
  (() => {
    // Calculateur
    const box = document.querySelector('[data-calc]');
    if (box) {
      const loc = calc.lang === 'fr' ? 'fr-CH' : 'en-GB';
      const money = (v) => (calc.lang === 'fr' ? '' : calc.cur) + Math.round(v).toLocaleString(loc).replace(/[  ,]/g, calc.lang === 'fr' ? ' ' : ',') + (calc.lang === 'fr' ? ' ' + calc.cur : '');
      const pct = (v) => (v * 100).toFixed(1).replace('.', calc.lang === 'fr' ? ',' : '.') + (calc.lang === 'fr' ? ' %' : '%');
      const signed = (v) => (v >= 0 ? '+' : '−') + money(Math.abs(v));
      const o = (k) => box.querySelector(`[data-o="${k}"]`);
      const num = (n) => { const el = box.querySelector(`[name="${n}"]`); return el ? parseFloat(el.value) || 0 : 0; };
      const run = () => {
        const P = Math.max(num('price'), 0), rent = num('rent') * 12, costs = num('costs'), tf = num('tf'), t = parseFloat(box.querySelector('[name="tmi"]').value) || 0, g = num('growth') / 100;
        let tax, cgt;
        if (calc.lang === 'fr') {
          tax = 0.7 * rent * (t + 0.172);
          const pv = P * (Math.pow(1 + g, 5) - 1); cgt = pv > 0 ? pv * 0.362 : 0;
          var gainPrice = pv - cgt;
        } else {
          tax = Math.max(rent - costs, 0) * t;
          const pv = P * (Math.pow(1 + g, 5) - 1); cgt = pv > 3000 ? (pv - 3000) * (t >= 0.44 ? 0.24 : 0.18) : 0;
          var gainPrice = pv - cgt;
        }
        const netH = rent - costs - tf - tax;
        const netG = P * 0.086 * 0.85;
        const g5H = 5 * netH + gainPrice;
        const g5G = 5 * netG + P * (Math.pow(1.05, 5) - 1);
        o('netH').textContent = money(netH) + (calc.lang === 'fr' ? '/an' : '/yr');
        o('yH').textContent = P ? pct(netH / P) : '–';
        o('g5H').textContent = signed(g5H);
        o('netG').textContent = money(netG) + (calc.lang === 'fr' ? '/an' : '/yr');
        o('g5G').textContent = signed(g5G);
        o('ratio').textContent = g5H > 0 ? (g5G / g5H).toFixed(1).replace('.', calc.lang === 'fr' ? ',' : '.') + '×' : '∞';
      };
      box.addEventListener('input', run); run();
    }
    // Formulaire bilan
    const form = document.querySelector('[data-bilan]');
    if (form) {
      const err = form.querySelector('[data-err]');
      const intl = (v) => { let n = v.replace(/[\s().\-\/]/g, ''); if (n.startsWith('00')) n = '+' + n.slice(2); return /^\+[1-9]\d{6,14}$/.test(n) ? n : null; };
      const tel = form.elements.namedItem('whatsapp');
      tel.addEventListener('focus', () => { if (!tel.value) tel.value = '+'; });
      tel.addEventListener('blur', () => { if (tel.value.trim() === '+') tel.value = ''; });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        if (fd.get('bot-field')) return;
        const n = intl(String(fd.get('whatsapp') || ''));
        const email = String(fd.get('email') || '').trim();
        if (!String(fd.get('prenom') || '').trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !n) { err.textContent = msg.err; err.hidden = false; return; }
        err.hidden = true;
        fd.set('whatsapp', n); fd.set('page', location.pathname + location.search);
        const btn = form.querySelector('button[type=submit]'); btn.disabled = true;
        try {
          const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(fd).toString() });
          if (!r.ok) throw new Error(String(r.status));
          form.hidden = true; document.querySelector('[data-ok]').hidden = false;
        } catch { err.textContent = msg.sendErr; err.hidden = false; btn.disabled = false; }
      });
    }
    // Barre fixe mobile
    const bar = document.querySelector('[data-sticky]');
    const watch = [document.querySelector('.ghero'), document.getElementById('bilan')].filter(Boolean);
    if (bar && 'IntersectionObserver' in window) {
      const seen = new Set(); bar.classList.add('is-hidden');
      const io = new IntersectionObserver((es) => { es.forEach((x) => (x.isIntersecting ? seen.add(x.target) : seen.delete(x.target))); bar.classList.toggle('is-hidden', seen.size > 0); }, { threshold: 0.05 });
      watch.forEach((w) => io.observe(w));
    }
  })();
</script>

<style>
  .flag { display: inline-block; width: 30px; height: 20px; border-radius: 3px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,.2); flex: none; vertical-align: middle; }
  .flag :global(svg) { display: block; width: 100%; height: 100%; }
  .gwrap { max-width: 980px; }
  /* hero */
  .ghero { background: radial-gradient(900px 600px at 90% 0%, #1c3a7a 0%, transparent 60%), var(--navy); color: var(--cream); }
  .ghero__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(28px, 5vw, 64px); padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(48px, 6vw, 88px); align-items: start; }
  .ghero h1 { font-weight: 400; font-size: clamp(1.9rem, 4.2vw, 3.3rem); margin-bottom: 18px; }
  .ghero h1 :global(em) { font-style: normal; color: var(--gold-light); }
  .ghero .lead { color: var(--muted-light); }
  .ghero__by { font-size: .82rem; color: var(--gold-light); margin: 16px 0 0; }
  .duo { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 28px 0 8px; }
  .duo__c { border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .duo__c--h { background: linear-gradient(150deg, rgba(47,111,214,.32), rgba(47,111,214,.08)); border: 1px solid rgba(110,150,230,.55); }
