        <div class="calc__o calc__o--g"><span class="flag" set:html={FLAG_GE} /><p>{T.c6.out.netGe}</p><strong data-o="netG">–</strong><p>{lang === 'fr' ? '7,3\u00a0%' : '7.3%'} · {T.c6.out.g5} <b data-o="g5G">–</b></p></div>
