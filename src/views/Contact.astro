---
import PageHero from '../components/PageHero.astro';
import Calendly from '../components/Calendly.astro';
import { SITE, CALENDLY, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { page } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const d = (await page(lang, 'misc')).contact;
const urls = { invest: CALENDLY.invest[lang], advisory: CALENDLY.advisory };
---
<PageHero eyebrow={d.eyebrow} title={d.title} lead={d.lead} />
<section class="section" style="padding-top:clamp(48px,6vw,80px)">
  <div class="wrap">
    <div class="topics" role="tablist">
      {(['invest', 'advisory'] as const).map((k, i) => (
        <button class="topic" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-topic={k} data-url={urls[k]}>
          <strong>{d[k].title}</strong>
          <span class="topic__t">{d[k].text}</span>
        </button>
      ))}
    </div>
    <div class="calwrap" data-calwrap>
      <Calendly url={urls.invest} lang={lang} height={760} />
    </div>
    <div class="direct">
      <a href={`mailto:${SITE.email}`} class="direct__i"><span class="eyebrow">E-mail</span>{SITE.email}</a>
      <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="direct__i"><span class="eyebrow">WhatsApp</span>{SITE.phone}</a>
    </div>
  </div>
</section>
<style>
  .topics { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .topic { text-align: left; padding: 28px 30px; background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; font: inherit; color: inherit; display: grid; gap: 6px; transition: all 0.3s var(--ease); }
  .topic strong { font-family: var(--f-title); font-size: 1.25rem; font-weight: 500; }
  .topic .num { margin-bottom: 6px; }
  .topic__t { color: var(--muted); font-size: 0.92rem; }
  .topic[aria-selected='true'] { background: var(--navy); color: var(--cream); border-color: var(--navy); }
  .topic[aria-selected='true'] .topic__t { color: var(--muted-light); }
  @media (max-width: 700px) { .topics { grid-template-columns: 1fr; } }
  .direct { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; }
  .direct__i { display: block; padding: 28px 30px; border-top: 1px solid var(--navy); text-decoration: none; font-family: var(--f-title); font-size: 1.15rem; overflow-wrap: anywhere; }
  .direct__i .eyebrow { display: flex; margin-bottom: 10px; }
  .direct__i:hover { color: var(--gold-deep); }
  @media (max-width: 700px) { .direct { grid-template-columns: 1fr; } }
</style>
<script>
  const wrap = document.querySelector<HTMLElement>('[data-calwrap] [data-calendly]');
  document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-topic]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      if (!wrap) return;
      const base = wrap.dataset.calendly!.split('?');
      wrap.dataset.calendly = b.dataset.url + '?' + base[1];
      wrap.querySelector('a.cal__fallback')?.setAttribute('href', b.dataset.url!);
      (window as any).efMountCalendly?.(wrap);
    }),
  );
  if (location.hash === '#advisory') document.querySelector<HTMLButtonElement>('[data-topic=advisory]')?.click();
</script>
