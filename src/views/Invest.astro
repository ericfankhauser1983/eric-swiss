---
import PageHero from '../components/PageHero.astro';
import Booking from '../components/Booking.astro';
import Simulator from '../components/Simulator.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import { SITE, CALENDLY, PHOTOS, HERO_VIDEOS, path, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { page } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const d = await page(lang, 'invest');
---
<PageHero eyebrow={d.hero.eyebrow} title={d.hero.title} lead={d.hero.lead} photo={PHOTOS.invest} video={HERO_VIDEOS.invest}>
  <a class="btn" href="#simulateur">{ui.cta.simulate} <span class="arrow">↓</span></a>
  <a class="btn btn--ghost" href="#rendez-vous">{ui.cta.bookInvest}</a>
</PageHero>

<section class="section section--sand partner">
  <div class="wrap partner__in reveal">
    <div>
      <p class="eyebrow">{d.partner.eyebrow}</p>
      <h2>{d.partner.title}</h2>
    </div>
    <div>
      <p class="lead">{d.partner.text}</p>
      <a class="btn btn--navy" href={SITE.partners.ffi} target="_blank" rel="noopener">{d.partner.cta} <span class="arrow">↗</span></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.what.eyebrow}</p><h2>{d.what.title}</h2></div>
      <p class="lead">{d.what.text}</p>
    </div>
    <ol class="steps">
      {d.what.steps.map((s: any, i: number) => (
        <li class="reveal" style={`transition-delay:${i * 90}ms`}>
          <span class="steps__n">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section section--sand">
  <div class="wrap mission reveal">
    <p class="eyebrow">{d.why.eyebrow}</p>
    <h2>{d.why.title}</h2>
    <hr class="rule" />
    <p class="mission__txt">{d.why.text}</p>
  </div>
</section>

<section class="section section--navy">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.georgia.eyebrow}</p><h2>{d.georgia.title}</h2></div>
    </div>
    <div class="stats reveal">
      {d.georgia.stats.map((s: any) => (
        <div class="stat"><div class="stat__v">{s.value}</div><p class="stat__l">{s.label}</p></div>
      ))}
    </div>
    <div class="cities">
      {d.cities.items.map((c: any) => (
        <div class="city reveal"><p class="eyebrow">{c.label}</p><h3>{c.name}</h3><p>{c.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.criteria.eyebrow}</p><h2>{d.criteria.title}</h2></div>
    </div>
    <div class="grid grid-3">
      {d.criteria.items.map((c: any, i: number) => (
        <div class="card reveal"><h3>{c.title}</h3><p>{c.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section section--sand">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.financing.eyebrow}</p><h2>{d.financing.title}</h2></div>
    </div>
    <div class="grid grid-3">
      {d.financing.items.map((c: any, i: number) => (
        <div class="card reveal"><h3>{c.title}</h3><p>{c.text}</p></div>
      ))}
    </div>
  </div>
</section>


<section class="section">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.payment.eyebrow}</p><h2>{d.payment.title}</h2></div>
    </div>
    <div class="grid grid-3">
      {d.payment.items.map((c: any) => (
        <div class="pay reveal"><h3>{c.title}</h3><p>{c.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section section--sand" id="simulateur">
  <div class="wrap">
    <div class="head reveal">
      <div><p class="eyebrow">{d.simulator.eyebrow}</p><h2>{d.simulator.title}</h2></div>
      <p class="lead">{d.simulator.text}</p>
    </div>
    <Simulator lang={lang} bookHref="#rendez-vous" />
  </div>
</section>



<Team lang={lang} filter={['Eric Fankhauser', 'Adrien Boucher', 'Léo Lawless']} />

<Faq eyebrow={d.faq.eyebrow} title={d.faq.title} items={d.faq.items} />

<Booking lang={lang} url={CALENDLY.invest[lang]} title={d.booking.title} text={d.booking.text} />

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 48px); counter-reset: s; }
  .steps li { position: relative; padding-top: 36px; border-top: 1px solid var(--navy); }
  .steps__n { position: absolute; top: -14px; left: 0; background: var(--cream); padding-right: 14px; font-family: var(--f-title); font-weight: 600; letter-spacing: 0.18em; font-size: 0.8rem; color: var(--gold); }
  .steps p { color: var(--muted); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .mission { max-width: 920px; text-align: center; }
  .mission .eyebrow::before { display: none; }
  .mission h2 { font-weight: 400; }
  .mission .rule { max-width: 160px; margin: 32px auto; }
  .mission__txt { font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--muted); max-width: 760px; margin: 0 auto; }
  .cities { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); margin-top: clamp(56px, 7vw, 96px); }
  .city { padding: 36px; border: 1px solid var(--line-light); }
  .city .eyebrow { margin-bottom: 14px; }
  .city h3 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 400; color: var(--gold-light); }
  .city p { color: var(--muted-light); margin: 0; }
  @media (max-width: 760px) { .cities { grid-template-columns: 1fr; } }
  .partner__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 6vw, 96px); align-items: start; }
  .partner .lead { margin-bottom: 32px; }
  .pay { padding-top: 28px; border-top: 1px solid var(--gold); }
  .pay p { color: var(--muted); }
  @media (max-width: 860px) { .partner__in { grid-template-columns: 1fr; } }
</style>
